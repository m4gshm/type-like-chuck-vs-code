{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "defaultBuildTask",
      "type": "npm",
      "script": "compile",
      "problemMatcher": {
        "owner": "esbuild",
        "severity": "error",
        "applyTo": "closedDocuments",
        "fileLocation": "relative",
        "pattern": [
          {
            "regexp": "^[✘▲] \\[([A-Z]+)\\] (.+)",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^(?:\\t| {4})(?!\\s)([^:]+)(?::([0-9]+))?(?::([0-9]+))?:$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "owner": "esbuild",
        "severity": "error",
        "applyTo": "closedDocuments",
        "fileLocation": "relative",
        "pattern": [
          {
            "regexp": "^[✘▲] \\[([A-Z]+)\\] (.+)",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^(?:\\t| {4})(?!\\s)([^:]+)(?::([0-9]+))?(?::([0-9]+))?:$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      },
      "isBackground": true,
      "background": {
        "activeOnStart": true,
        "beginsPattern": "build started",
        "endsPattern": "build finished"
      }
    },
    {
      "label": "preDebug",
      "type": "npm",
      "script": "sync-runner",
      "problemMatcher": [],
      "dependsOn": ["defaultBuildTask"]
    },
    {
      // preLaunch of the "release" launch configuration: fetch the pinned
      // backend release (download-only, no local build) next to the local one.
      "label": "preDebugRelease",
      "type": "npm",
      "script": "sync-runner-release",
      "problemMatcher": [],
      "dependsOn": ["defaultBuildTask"]
    }
  ]
}
